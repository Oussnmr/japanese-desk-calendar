{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "japanese-desk-calendar",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-02",
  // Shared editor profiles. Without this binding the calendar still works:
  // /api/profiles answers 503 and profiles stay local to each browser.
  "kv_namespaces": [
    { "binding": "EDITOR_PROFILES", "id": "48dd87f86ff845ffbee4935f878d4895" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/setup/*"]
  }
}
