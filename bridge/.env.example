BRIDGE_PORT=8787
BRIDGE_HOST=0.0.0.0
# Long random shared secret - the Worker sends this as "Authorization: Bearer <value>".
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BRIDGE_TOKEN=

# From `cloudflared tunnel create` (or the token shown when creating a tunnel
# in the Zero Trust dashboard: Networks > Tunnels > your tunnel > Configure).
CLOUDFLARE_TUNNEL_TOKEN=

# The tunnel's public hostname (Networks > Tunnels > your tunnel > Public
# Hostname). Not read by bridge.py itself - only used by
# scripts/prepare-cloud-secrets.mjs to seed the Worker's BRIDGE_URL secret.
BRIDGE_URL=https://bridge.example.com

# Only needed once, to run `python -m tinytuya wizard` and produce devices.json.
# Never used by bridge.py itself - safe to remove from this file afterwards.
TUYA_API_REGION=eu
TUYA_API_KEY=
TUYA_API_SECRET=

# Device ids (not secrets by themselves, but only meaningful together with
# devices.json's local_keys). Only used by scripts/prepare-cloud-secrets.mjs
# to seed the matching Worker secrets - bridge.py reads devices.json instead.
TUYA_DEVICE_ID=
TUYA_DEVICE_ID_PLUG_LED=
TUYA_DEVICE_ID_PLUG_LAMPE=
TUYA_DEVICE_ID_PLUG_MULTIPRISES=
TUYA_DEVICE_ID_PLUG_PROJECTEUR=
