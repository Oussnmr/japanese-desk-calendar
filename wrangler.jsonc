{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "japanese-desk-calendar",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-02",
  // Shared editor profiles. Create the namespace once with
  //   npx wrangler kv namespace create EDITOR_PROFILES
  // then paste the returned id below and uncomment this block.
  // Without it the calendar still works: profiles simply stay local to each browser.
  // "kv_namespaces": [
  //   { "binding": "EDITOR_PROFILES", "id": "PASTE_NAMESPACE_ID_HERE" }
  // ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/setup/*"]
  }
}
